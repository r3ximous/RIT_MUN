---
import Layout from '../layouts/Layout.astro';
import { Mail, MapPin } from 'lucide-react';
import PageHead from '../components/astro/PageHead.astro';
---

<Layout title="RIT MUN | Contact Us">
  <PageHead
    title="Contact"
    lede="Questions about registration, committees or sponsorship? The Secretariat typically replies within 24 hours."
    crumbs={[{ label: 'Contact' }]}
  />
  <div class="contact-page-wrapper">
    <div class="contact-info-col">
      <p class="eyebrow">The Secretariat</p>
      <h1 class="contact-title">Get in Touch</h1>
      <p class="contact-subtitle">
        Need assistance with registration or have a question about a committee?
        The RIT Dubai MUN Secretariat is here to help.
      </p>

      <div class="contact-methods">
        <div class="contact-method-item">
          <div class="contact-icon-box">
            <Mail className="icon-md" aria-hidden="true" />
          </div>
          <div>
            <h3 class="contact-method-title">Email</h3>
            <a href="mailto:secgen@ritmun.org" class="contact-email-link">
              secgen@ritmun.org
            </a>
          </div>
        </div>

        <div class="contact-method-item">
          <div class="contact-icon-box">
            <MapPin className="icon-md" aria-hidden="true" />
          </div>
          <div>
            <h3 class="contact-method-title">Office</h3>
            <address class="contact-address">
              Rochester Institute of Technology of Dubai<br />
              Dubai Silicon Oasis<br />
              Dubai, United Arab Emirates
            </address>
          </div>
        </div>
      </div>
    </div>

    <div class="contact-form-box">
      <h2 class="contact-form-title">Send a Message</h2>
      <form id="contact-form" class="contact-form">
        <div>
          <label for="name" class="form-label">Name</label>
          <input
            type="text"
            id="name"
            name="name"
            class="form-input"
            placeholder="Jane Doe"
            required
          />
        </div>
        <div>
          <label for="email" class="form-label">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            class="form-input"
            placeholder="jane@example.com"
            required
          />
        </div>
        <div>
          <label for="topic" class="form-label">What is it about?</label>
          <select id="topic" name="topic" class="form-input">
            <option>Registration</option>
            <option>Committees</option>
            <option>Sponsorship</option>
            <option>Something else</option>
          </select>
        </div>
        <div>
          <label for="message" class="form-label">Message</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            class="form-textarea"
            placeholder="How can we help?"
            required
          ></textarea>
        </div>
        <button type="submit" class="form-submit-btn">Send Message</button>
      </form>
      <div
        id="contact-form-success"
        role="status"
        class="hidden rounded-lg border border-brand-orange/30 bg-brand-orange/10 p-4 text-brand-dark"
        style="margin-top: 16px;"
      >
        Thanks for reaching out! This form is awaiting a backend connection.
        Please email <a href="mailto:secgen@ritmun.org" class="contact-email-link">secgen@ritmun.org</a>.
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const success = document.getElementById('contact-form-success');

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      form.reset();
      form.classList.add('hidden');
      success?.classList.remove('hidden');
    });
  </script>
</Layout>
