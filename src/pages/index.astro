---
import { Image } from "astro:assets";
import bannerImg from "../Images/banner_plain_2.png";
import Layout from "../layouts/Layout.astro";
import CountdownTimer from "../components/react/CountdownTimer";
import { Users, Award, MapPin, ArrowRight, Calendar, Building2, DollarSign } from "lucide-react";

// Conference details - specific and verifiable
const conferenceDetails = {
  name: "RIT Model United Nations Conference 2026",
  dates: "December 4-6, 2026",
  location: "Rochester Institute of Technology",
  venue: "Gosnell Hall & Student Alumni Union",
  committees: 12,
  expectedDelegates: "250+",
  schoolsAttended: "40+",
  earlyBirdPrice: "$40",
  regularPrice: "$55",
  earlyBirdDeadline: "November 1, 2026",
};

// Actual committee lineup
const committeeLineup = [
  { name: "UN Security Council", type: "Crisis", difficulty: "Advanced" },
  { name: "World Health Organization", type: "Specialized", difficulty: "Beginner" },
  { name: "UN Human Rights Council", type: "General Assembly", difficulty: "Intermediate" },
  { name: "DISEC", type: "General Assembly", difficulty: "Intermediate" },
];

// Structured data so search engines understand this page represents a real
// event (dates/location mirror the schedule collection and Contact page).
const eventJsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: "RIT Model United Nations Conference",
  description:
    "Join 250+ delegates from 40+ schools at Rochester Institute of Technology for our annual MUN conference featuring 12 committees across three days of debate.",
  startDate: "2026-12-04T15:00:00-05:00",
  endDate: "2026-12-06T15:00:00-05:00",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  eventStatus: "https://schema.org/EventScheduled",
  location: {
    "@type": "Place",
    name: "Rochester Institute of Technology",
    address: {
      "@type": "PostalAddress",
      streetAddress: "1 Lomb Memorial Dr",
      addressLocality: "Rochester",
      addressRegion: "NY",
      postalCode: "14623",
      addressCountry: "US",
    },
  },
  organizer: {
    "@type": "Organization",
    name: "RIT Model United Nations",
    url: Astro.site ? new URL("/", Astro.site).toString() : undefined,
  },
  offers: {
    "@type": "Offer",
    price: "40.00",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
    validFrom: "2026-09-01",
  },
};
---

<Layout title="RIT MUN | Homepage">
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(eventJsonLd)}
    />
  </Fragment>
  {/* Hero Section */}
  <section
    class="relative text-white pt-24 pb-32 px-6 overflow-hidden min-h-[70vh] flex items-center"
  >
    {/* Optimized Absolute Background Image */}
    <div class="absolute inset-0 w-full h-full z-0">
      <Image
        src={bannerImg}
        alt="RIT MUN Conference"
        class="w-full h-full object-cover object-center"
        loading="eager"
        widths={[640, 1024, 1600, 2000]}
        sizes="100vw"
        format="avif"
        quality="high"
      />
      {/* Dark overlay to guarantee text readability */}
      <div
        class="absolute inset-0 bg-brand-dark/20 bg-linear-to-r from-brand-dark/95 to-brand-dark/40"
      >
      </div>
    </div>

    {/* Content Area */}
    <div class="max-w-7xl mx-auto flex flex-col z-10 w-full relative">
      <div
        class="hero-content max-w-3xl text-center md:text-left space-y-6 mx-auto md:mx-0"
      >
        <div
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 text-brand-orange text-sm font-semibold mb-2 border border-brand-orange/30 backdrop-blur-sm"
        >
          <span>{conferenceDetails.dates} • {conferenceDetails.venue}</span>
        </div>

        <h1
          class="text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight"
        >
          Debate Global Crises at <span class="text-brand-highlight">RIT</span>
        </h1>

        <p
          class="text-lg md:text-xl lg:text-2xl text-gray-200 max-w-2xl mx-auto md:mx-0"
        >
          Join {conferenceDetails.expectedDelegates} delegates from {conferenceDetails.schoolsAttended} schools for our annual conference featuring {conferenceDetails.committees} committees. Early bird registration: {conferenceDetails.earlyBirdPrice}.
        </p>

        <div
          class="pt-6 flex flex-col sm:flex-row gap-4 justify-center md:justify-start"
        >
          <a href="/registration" class="hero-btn-primary">
            Register Now <ArrowRight />
          </a>
          <a href="/committees" class="hero-btn-secondary backdrop-blur-md">
            View Committees
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Island Architecture: Countdown - Now tied to early bird deadline */}
  <CountdownTimer client:load />

  {/* About Section - Replaced generic feature cards with specific info */}
  <section class="features-section">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-extrabold text-brand-dark mb-8 text-center">What to Expect</h2>
      
      {/* Quick Stats Bar */}
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-16">
        <div class="text-center p-4 bg-white rounded-lg shadow-sm">
          <div class="flex justify-center mb-2">
            <Users className="w-8 h-8 text-brand-orange" />
          </div>
          <div class="text-3xl font-bold text-brand-dark">{conferenceDetails.expectedDelegates}</div>
          <div class="text-sm text-gray-600">Delegates</div>
        </div>
        <div class="text-center p-4 bg-white rounded-lg shadow-sm">
          <div class="flex justify-center mb-2">
            <Award className="w-8 h-8 text-brand-orange" />
          </div>
          <div class="text-3xl font-bold text-brand-dark">{conferenceDetails.committees}</div>
          <div class="text-sm text-gray-600">Committees</div>
        </div>
        <div class="text-center p-4 bg-white rounded-lg shadow-sm">
          <div class="flex justify-center mb-2">
            <Building2 className="w-8 h-8 text-brand-orange" />
          </div>
          <div class="text-3xl font-bold text-brand-dark">{conferenceDetails.schoolsAttended}</div>
          <div class="text-sm text-gray-600">Schools</div>
        </div>
        <div class="text-center p-4 bg-white rounded-lg shadow-sm">
          <div class="flex justify-center mb-2">
            <DollarSign className="w-8 h-8 text-brand-orange" />
          </div>
          <div class="text-3xl font-bold text-brand-dark">{conferenceDetails.earlyBirdPrice}</div>
          <div class="text-sm text-gray-600">Early Bird</div>
        </div>
      </div>

      {/* Committee Preview */}
      <div class="mb-16">
        <h3 class="text-2xl font-bold text-brand-dark mb-6">Featured Committees</h3>
        <div class="grid md:grid-cols-2 gap-6">
          {committeeLineup.map((committee) => (
            <div class="bg-white p-6 rounded-xl border border-gray-200 hover:border-brand-orange transition-colors">
              <div class="flex justify-between items-start mb-3">
                <h4 class="text-xl font-bold text-brand-dark">{committee.name}</h4>
                <span class="text-xs font-semibold text-brand-orange uppercase tracking-wider bg-orange-50 px-2 py-1 rounded">{committee.type}</span>
              </div>
              <p class="text-gray-600 text-sm mb-3">Difficulty: {committee.difficulty}</p>
              <a href="/committees" class="text-brand-orange font-semibold text-sm hover:underline">View all topics →</a>
            </div>
          ))}
        </div>
        <div class="text-center mt-8">
          <a href="/committees" class="inline-flex items-center gap-2 text-brand-orange font-bold hover:text-orange-600 transition-colors">
            See all {conferenceDetails.committees} committees <ArrowRight class="w-4 h-4" />
          </a>
        </div>
      </div>

      {/* Weekend Timeline */}
      <div>
        <h3 class="text-2xl font-bold text-brand-dark mb-6">Conference Timeline</h3>
        <div class="space-y-4">
          <div class="flex gap-4 items-start">
            <div class="w-32 flex-shrink-0 text-right">
              <div class="font-bold text-brand-dark">Friday, Dec 4</div>
              <div class="text-sm text-gray-600">3:00 PM - 10:00 PM</div>
            </div>
            <div class="flex-1 bg-white p-4 rounded-lg border-l-4 border-brand-orange">
              <div class="font-bold text-brand-dark">Registration & Opening Ceremonies</div>
              <div class="text-sm text-gray-600">Check-in at Campus Center, followed by opening ceremonies in Ingle Auditorium</div>
            </div>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-32 flex-shrink-0 text-right">
              <div class="font-bold text-brand-dark">Saturday, Dec 5</div>
              <div class="text-sm text-gray-600">8:00 AM - 6:00 PM</div>
            </div>
            <div class="flex-1 bg-white p-4 rounded-lg border-l-4 border-brand-orange">
              <div class="font-bold text-brand-dark">Full Day of Committee Sessions</div>
              <div class="text-sm text-gray-600">Three sessions of debate, negotiation, and resolution drafting</div>
            </div>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-32 flex-shrink-0 text-right">
              <div class="font-bold text-brand-dark">Sunday, Dec 6</div>
              <div class="text-sm text-gray-600">8:00 AM - 3:00 PM</div>
            </div>
            <div class="flex-1 bg-white p-4 rounded-lg border-l-4 border-brand-orange">
              <div class="font-bold text-brand-dark">Final Session & Closing Ceremonies</div>
              <div class="text-sm text-gray-600">Final debates followed by awards ceremony</div>
            </div>
          </div>
        </div>
        <div class="text-center mt-8">
          <a href="/schedule" class="inline-flex items-center gap-2 text-brand-orange font-bold hover:text-orange-600 transition-colors">
            View full schedule <ArrowRight class="w-4 h-4" />
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
