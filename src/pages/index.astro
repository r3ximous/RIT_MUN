---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import CountdownTimer from '../components/react/CountdownTimer';

const committees = (await getCollection('committees')).sort(
  (a, b) => a.data.order - b.data.order,
);
const schedule = (await getCollection('schedule')).sort(
  (a, b) => a.data.order - b.data.order,
);
const committeeCount = committees.length;
const topicCount = committees.reduce(
  (total, committee) => total + committee.data.topics.length,
  0,
);
const conferenceDays = schedule.length;
const sessionCount = schedule.reduce(
  (total, day) =>
    total + day.data.events.filter((event) => event.type === 'Session').length,
  0,
);

const eventJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'EducationEvent',
  name: 'RIT Dubai Model United Nations 2026',
  description:
    'Join delegates at RIT Dubai for a weekend of rigorous debate, negotiation and global problem-solving.',
  startDate: '2026-12-04T15:00:00+04:00',
  endDate: '2026-12-06T15:00:00+04:00',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: 'Rochester Institute of Technology of Dubai',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Dubai Silicon Oasis',
      addressLocality: 'Dubai',
      addressCountry: 'AE',
    },
  },
  organizer: {
    '@type': 'CollegeOrUniversity',
    name: 'Rochester Institute of Technology of Dubai',
  },
};

const committeeAbbreviations: Record<string, string> = {
  unsc: 'UNSC',
  who: 'WHO',
  unhrc: 'UNHRC',
  disec: 'DISEC',
};
---

<Layout
  title="RIT Dubai MUN | Home"
  description="RIT Dubai Model United Nations, December 4–6, 2026 at Rochester Institute of Technology of Dubai."
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(eventJsonLd)} />
  </Fragment>

  <section class="hero" aria-labelledby="hero-title">
    <picture class="hero-photo">
      <source
        type="image/avif"
        srcset="/img/campus-800.avif 800w, /img/campus.avif 1366w"
        sizes="100vw"
      />
      <img
        src="/img/campus.jpg"
        srcset="/img/campus-800.jpg 800w, /img/campus.jpg 1366w"
        sizes="100vw"
        alt="The entrance of Rochester Institute of Technology of Dubai, with the RIT sign in orange above the doors"
        width="1366"
        height="688"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap hero-in">
      <p class="hero-tag">Diplomacy in Action</p>
      <h1 id="hero-title">RIT Dubai Model United Nations</h1>
      <p class="hero-meta">December 4–6, 2026 at RIT Dubai, Dubai Silicon Oasis</p>
      <div class="hero-ctas">
        <a class="btn btn-orange btn-lg" href="/registration/">Register</a>
        <a class="btn btn-outline btn-lg btn-on-dark" href="/committees/">Explore committees</a>
      </div>
    </div>
  </section>

  <section class="cd-bar" aria-label="Countdown to the conference">
    <div class="wrap cd-bar-in">
      <CountdownTimer client:load />
      <div class="cd-side">
        <p><strong>December 4–6, 2026</strong><br />RIT Dubai, Dubai Silicon Oasis</p>
        <a class="btn btn-outline btn-on-dark" href="/documents/ritd-mun-2026.ics" download="ritd-mun-2026.ics">
          Add to calendar
        </a>
      </div>
    </div>
  </section>

  <section class="section stats-section" aria-label="At a glance">
    <div class="wrap">
      <ul class="stats" aria-label="The conference in numbers">
        <li class="stat"><b class="num"><span class="sr-only">{committeeCount}</span><span aria-hidden="true">{committeeCount}</span></b><span>Committees</span></li>
        <li class="stat"><b class="num"><span class="sr-only">{topicCount}</span><span aria-hidden="true">{topicCount}</span></b><span>Agenda topics</span></li>
        <li class="stat"><b class="num"><span class="sr-only">{conferenceDays}</span><span aria-hidden="true">{conferenceDays}</span></b><span>Days of debate</span></li>
        <li class="stat"><b class="num"><span class="sr-only">{sessionCount}</span><span aria-hidden="true">{sessionCount}</span></b><span>Committee sessions</span></li>
      </ul>
    </div>
  </section>

  <section class="section intro" aria-labelledby="intro-title">
    <div class="wrap intro-in">
      <div class="intro-copy">
        <h2 id="intro-title" class="section-h">A conference built for young diplomats</h2>
        <p class="lead">
          Join delegates at RIT Dubai for a weekend of rigorous debate,
          negotiation and global problem-solving.
        </p>
        <p>Open to high school and university students. Beginners to advanced delegates are welcome.</p>
        <p><a class="link-arrow" href="/resources/">New to Model UN? Start with the delegate guides</a></p>
      </div>
      <ul class="pillars">
        <li class="pillar">
          <h3>Diverse committees</h3>
          <p>From fast-paced crisis rooms to the expansive General Assembly, there is a seat for every level of experience.</p>
        </li>
        <li class="pillar">
          <h3>Skill building</h3>
          <p>Sharpen public speaking, negotiation and policy writing: skills that carry into university and beyond.</p>
        </li>
        <li class="pillar">
          <h3>RIT Dubai campus</h3>
          <p>Debate inside the cutting-edge facilities of Rochester Institute of Technology's Dubai campus.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section-alt" aria-label="Welcome letter">
    <div class="wrap narrow">
      <article class="letter" aria-labelledby="letter-title">
        <header class="letter-head">
          <h2 id="letter-title" class="section-h">Letter from the Secretary-General</h2>
          <p class="draft-chip">Draft placeholder: to be replaced with the Secretary-General’s own letter</p>
        </header>
        <div class="letter-body">
          <p>Dear delegates,</p>
          <p>
            Welcome to RIT Dubai Model United Nations. Over three days at our
            campus in Dubai Silicon Oasis, you will debate the questions that
            real diplomats continue to address, from cyber security to access
            to essential medicines.
          </p>
          <p>
            Whether this is your first conference or your tenth, our committees
            are designed to challenge you and help you grow as a speaker,
            negotiator and writer. Our chairs and Secretariat will support you
            at every step.
          </p>
          <p>We look forward to welcoming you to RIT Dubai in December.</p>
          <p class="sig">
            <span class="sig-name">Rex Marciano</span>
            <span class="sig-role">Secretary-General, RIT Dubai Model United Nations</span>
          </p>
        </div>
      </article>
    </div>
  </section>

  <section class="section" aria-labelledby="committees-title">
    <div class="wrap">
      <div class="section-top">
        <h2 id="committees-title" class="section-h">Committees</h2>
        <a class="link-arrow" href="/committees/">Compare all committees</a>
      </div>
      <ul class="com-cards">
        {committees.map((committee) => (
          <li class="com-card">
            <div class="com-card-top">
              <span class={`tag tag-${committee.data.difficulty.toLowerCase()}`}>
                {committee.data.difficulty}
              </span>
              <span class="com-type">{committee.data.type}</span>
            </div>
            <h3>
              <a class="card-link" href={`/committees/${committee.id}/`}>
                <abbr title={committee.data.name}>{committeeAbbreviations[committee.id] ?? committee.id.toUpperCase()}</abbr>
              </a>
            </h3>
            <p class="com-full">{committee.data.name}</p>
            <ul class="com-topics">
              {committee.data.topics.map((topic) => <li>{topic}</li>)}
            </ul>
            <a class="link-arrow" href={`/committees/${committee.id}/`}>Committee details</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="dates-title">
    <div class="wrap split">
      <div>
        <h2 id="dates-title" class="section-h">Key dates</h2>
        <ol class="key-dates">
          <li class="kd" data-kind="registration">
            <time datetime="2026-09-15" class="num tbc">September 15, 2026</time>
            <span>Early bird registration closes</span>
          </li>
          <li class="kd" data-kind="registration">
            <time datetime="2026-10-20" class="num">October 20, 2026</time>
            <span>Regular registration closes</span>
          </li>
          <li class="kd" data-kind="paper">
            <time datetime="2026-11-01" class="num">November 1, 2026</time>
            <span>Position papers due</span>
          </li>
          <li class="kd kd-final" data-kind="conference">
            <time datetime="2026-12-04" class="num">December 4–6, 2026</time>
            <span>Conference at RIT Dubai</span>
          </li>
        </ol>
      </div>
      <aside class="fee-teaser" aria-labelledby="fee-teaser-title">
        <h3 id="fee-teaser-title">Registration fees</h3>
        <ul>
          <li><span>Early bird</span><b class="num">USD 45</b></li>
          <li><span>Regular</span><b class="num">USD 60</b></li>
          <li><span>Delegation fee</span><b class="num">USD 30</b></li>
        </ul>
        <a class="link-arrow" href="/registration/">Fees and how to register</a>
      </aside>
    </div>
  </section>

  <section class="cta-band" aria-labelledby="cta-title">
    <div class="wrap cta-in">
      <h2 id="cta-title">Take your seat at RIT Dubai MUN 2026</h2>
      <div class="reg-cta">
        <p class="reg-status"><span class="reg-status-dot" aria-hidden="true"></span>The registration form opens soon</p>
        <p>
          Registration is through the RIT Dubai MUN registration form. Follow
          <a href="https://www.instagram.com/ritd.mun/" target="_blank" rel="noopener">
            @ritd.mun on Instagram<span class="sr-only"> (opens in a new tab)</span>
          </a>
          for the announcement.
        </p>
        <a class="btn btn-orange btn-lg" href="/registration/">Registration details</a>
      </div>
    </div>
  </section>
</Layout>
