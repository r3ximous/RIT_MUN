---
import { getCollection, render } from "astro:content";
import CommitteeFacts from "../../components/astro/CommitteeFacts.astro";
import CommitteePager from "../../components/astro/CommitteePager.astro";
import Layout from "../../layouts/Layout.astro";
import PageHead from "../../components/astro/PageHead.astro";
import {
  difficultyDescriptions,
  formatExplanations,
} from "../../data/committee-copy";

export async function getStaticPaths() {
  const committees = (await getCollection("committees")).sort(
    (a, b) => a.data.order - b.data.order,
  );

  return committees.map((committee, index) => {
    const previous =
      committees[(index + committees.length - 1) % committees.length];
    const next = committees[(index + 1) % committees.length];

    return {
      params: { id: committee.id },
      props: {
        committee,
        previous: { id: previous.id, abbr: previous.data.abbr },
        next: { id: next.id, abbr: next.data.abbr },
      },
    };
  });
}

const { committee, previous, next } = Astro.props;
const { Content } = await render(committee);
const formatCopy = formatExplanations[committee.data.type];
---

<Layout title={`RIT MUN | ${committee.data.name}`}>
  <PageHead
    title={committee.data.name}
    lede={committee.data.description}
    kicker={committee.data.abbr}
    crumbs={[
      { label: "Committees", href: "/committees/" },
      { label: committee.data.abbr },
    ]}
  />

  <section class="section" aria-label={`${committee.data.abbr} overview`}>
    <div class="wrap com-layout">
      <div class="com-main">
        <section class="com-block" aria-labelledby="agenda-title">
          <h2 id="agenda-title" class="section-h" data-reveal>Agenda</h2>
          <ol class="agenda">
            {
              committee.data.topics.map((topic, index) => (
                <li data-reveal>
                  <span class="agenda-n num">Topic {index + 1}</span>
                  <span class="agenda-t">{topic}</span>
                </li>
              ))
            }
          </ol>
          <p class="soon-line" data-reveal>
            <span class="soon-chip">Study guide coming soon</span>
            The study guide will set out the background to both topics and the questions
            a resolution should answer.
          </p>
        </section>

        <section class="com-block" aria-labelledby="about-title">
          <h2 id="about-title" class="section-h" data-reveal>About</h2>
          <div class="prose-p" data-reveal>
            <Content />
          </div>
        </section>

        <section class="com-block" aria-labelledby="format-title">
          <h2 id="format-title" class="section-h" data-reveal>
            {formatCopy.heading}
          </h2>
          <p class="prose-p" data-reveal>{formatCopy.description}</p>
        </section>

        <section class="com-block" aria-labelledby="fit-title">
          <h2 id="fit-title" class="section-h" data-reveal>
            Is this committee right for you?
          </h2>
          <p class="prose-p" data-reveal>
            {difficultyDescriptions[committee.data.difficulty]}
          </p>
          <p data-reveal>
            <a class="link-arrow" href="/committees/">
              Compare all four committees
            </a>
          </p>
        </section>

        <section class="com-block" aria-labelledby="chairs-title">
          <h2 id="chairs-title" class="section-h" data-reveal>Chairs</h2>
          <p class="prose-p" data-reveal>
            {
              committee.data.chairs === "TBC" ? (
                <>
                  <span class="tbc">The chairs for this committee</span> will be
                  announced here.
                </>
              ) : (
                committee.data.chairs
              )
            }
          </p>
        </section>
      </div>

      <aside class="com-side" aria-label="Committee facts">
        <CommitteeFacts
          type={committee.data.type}
          difficulty={committee.data.difficulty}
          size={committee.data.size}
          topicCount={committee.data.topics.length}
          positionPaperDue={committee.data.positionPaperDue}
        />
        <div class="side-links" data-reveal>
          <a class="link-arrow" href="/delegates/position-papers/">
            Position paper guide
          </a>
          <a class="link-arrow" href="/delegates/rules-of-procedure/">
            Rules of procedure
          </a>
        </div>
        <div class="reg-cta" data-reveal>
          <p class="reg-status">
            <span class="reg-status-dot" aria-hidden="true"></span>The
            registration form opens soon
          </p>
          <p>
            Registration is through the RIT Dubai MUN registration form. Follow
            <a
              href="https://www.instagram.com/ritd.mun/"
              target="_blank"
              rel="noopener"
            >
              @ritd.mun on Instagram<span class="sr-only">
                (opens in a new tab)</span
              >
            </a>
            for the announcement.
          </p>
          <a class="link-arrow" href="/registration/">Registration details</a>
        </div>
      </aside>
    </div>
  </section>

  <CommitteePager previous={previous} next={next} />
</Layout>
