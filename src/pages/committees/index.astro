---
import { getCollection } from "astro:content";
import DifficultyBadge from "../../components/astro/DifficultyBadge.astro";
import Layout from "../../layouts/Layout.astro";
import PageHead from "../../components/astro/PageHead.astro";
import { difficultyDescriptions } from "../../data/committee-copy";

const committees = (await getCollection("committees")).sort(
  (a, b) => a.data.order - b.data.order,
);
const levels = ["Beginner", "Intermediate", "Advanced"] as const;
---

<Layout title="RIT MUN | Committees">
  <PageHead
    title="Committees"
    lede="Four committees, each designed to challenge delegates on pressing global issues, from first-timer friendly to full crisis."
    crumbs={[{ label: "Committees" }]}
  />

  <section class="section" aria-label="All committees">
    <div class="wrap">
      <ul class="com-list">
        {
          committees.map((committee) => (
            <li class="com-row" data-reveal>
              <p class="com-abbr" aria-hidden="true">
                {committee.data.abbr}
              </p>
              <div class="com-row-main">
                <h2>
                  <a class="card-link" href={`/committees/${committee.id}/`}>
                    {committee.data.name}
                  </a>
                </h2>
                <p class="com-meta" data-reveal>
                  <span>{committee.data.type}</span>
                  <DifficultyBadge difficulty={committee.data.difficulty} />
                  <span>{committee.data.size} committee</span>
                </p>
                <p class="com-blurb" data-reveal>
                  {committee.data.description}
                </p>
                <ul class="com-topics">
                  {committee.data.topics.map((topic) => (
                    <li data-reveal>{topic}</li>
                  ))}
                </ul>
              </div>
              <a
                class="link-arrow link-arrow--chevron"
                href={`/committees/${committee.id}/`}
              >
                View committee
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="choose-title">
    <div class="wrap">
      <h2 id="choose-title" class="section-h" data-reveal>
        Choosing a committee
      </h2>
      <ul class="levels">
        {
          levels.map((level) => {
            const matches = committees.filter(
              (committee) => committee.data.difficulty === level,
            );
            return (
              <li class="level" data-reveal>
                <h3>
                  <DifficultyBadge difficulty={level} />
                </h3>
                <p>{difficultyDescriptions[level]}</p>
                <p class="level-coms">
                  {matches.map((committee, index) => (
                    <>
                      {index > 0 && ", "}
                      <a href={`/committees/${committee.id}/`}>
                        {committee.data.abbr}
                      </a>
                    </>
                  ))}
                </p>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>
</Layout>
