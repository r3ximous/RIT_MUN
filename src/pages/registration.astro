---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/astro/PageHead.astro';
---

<Layout title="Registration | RIT Dubai MUN 2026">
  <PageHead
    title="Registration"
    lede="Registration includes access to all committee sessions, the delegate social and conference materials."
    crumbs={[{ label: 'Registration' }]}
  />

  <section class="registration-section">
    <div class="registration-content">
      <p class="eyebrow">Conference fees</p>
      <h2 data-reveal>Fees</h2>
      <div class="fees">
        <article class="fee" data-reveal>
          <span class="fee-label">Early bird</span>
          <span class="fee-price"><small>USD</small>45</span>
          <span class="fee-note">Until September 15, 2026</span>
        </article>
        <article class="fee" data-reveal>
          <span class="fee-label">Regular</span>
          <span class="fee-price"><small>USD</small>60</span>
          <span class="fee-note">Until October 20, 2026</span>
        </article>
        <article class="fee" data-reveal>
          <span class="fee-label">Delegation fee</span>
          <span class="fee-price"><small>USD</small>30</span>
          <span class="fee-note">Details on the registration form</span>
        </article>
      </div>
      <p class="included" data-reveal>Registration includes access to all committee sessions, the delegate social and conference materials.</p>
      <div class="reg-status">
        <p data-reveal><span class="status-dot"></span>The registration form opens soon</p>
        <p>
          Follow <a href="https://www.instagram.com/ritd.mun/" target="_blank" rel="noopener">@ritd.mun on Instagram</a>
          for the announcement.
        </p>
      </div>
    </div>
  </section>

  <section class="registration-how">
    <div class="registration-how-in">
      <div>
        <p class="eyebrow">The process</p>
        <h2 data-reveal>How to register</h2>
        <ol class="steps">
          <li data-reveal>Fill in the RIT Dubai MUN registration form, as an individual delegate or part of a school delegation.</li>
          <li data-reveal>Pay your registration fee following the instructions the Secretariat sends you.</li>
          <li data-reveal>Receive your committee and country allocation from the Secretariat.</li>
          <li data-reveal>Research your country and submit your position paper by November 1, 2026.</li>
        </ol>
        <p class="tools-note">Exact steps will be confirmed when the registration form opens.</p>
      </div>
      <div>
        <p class="eyebrow">Plan ahead</p>
        <h2 data-reveal>Key dates</h2>
        <ol class="key-dates">
          <li data-reveal><time datetime="2026-09-15">September 15, 2026</time><span>Early bird registration closes</span></li>
          <li data-reveal><time datetime="2026-10-20">October 20, 2026</time><span>Regular registration closes</span></li>
          <li data-reveal><time datetime="2026-11-01">November 1, 2026</time><span>Position papers due</span></li>
          <li class="final-date" data-reveal><time datetime="2026-12-04">December 4–6, 2026</time><span>Conference at RIT Dubai</span></li>
        </ol>
      </div>
    </div>
  </section>

  <section class="position-papers-section">
    <div>
      <p class="eyebrow">Awards and preparation</p>
      <h2 data-reveal>Position papers</h2>
      <p class="note-strong" data-reveal>Position papers are required for award consideration and are due November 1, 2026.</p>
      <a class="link-arrow" href="/delegates/position-papers/" data-reveal>Read the position paper guide</a>
    </div>
  </section>
</Layout>
