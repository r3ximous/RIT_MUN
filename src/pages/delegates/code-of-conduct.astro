---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/astro/PageHead.astro';
---

<Layout title="Code of Conduct | RIT MUN">
  <PageHead title="Code of Conduct" lede="The standards every delegate agrees to during the conference." crumbs={[{ label: 'Delegates', href: '/resources' }, { label: 'Code of Conduct' }]} />
  <section class="guide-detail-section">
    <div class="guide-layout">
      <nav class="toc" aria-label="On this page"><h2>On this page</h2><ol><li><a href="#respect">Respect</a></li><li><a href="#conduct">Diplomatic conduct</a></li><li><a href="#attendance">Attendance</a></li><li><a href="#integrity">Academic integrity</a></li><li><a href="#concern">Raising a concern</a></li></ol></nav>
      <article class="guide-prose">
        <p class="draft-note"><strong>Draft.</strong> This guide is based on standard Model UN practice. The Secretariat will publish the official version before the conference.</p>
        <section id="respect"><h2>Respect</h2><p>Every delegate, chair, staff member and guest is entitled to respect. Harassment, discrimination and personal attacks have no place at the conference.</p></section>
        <section id="conduct"><h2>Diplomatic conduct</h2><ul class="bullets"><li>Address the chair and delegates formally during debate.</li><li>Represent your assigned country’s policy faithfully.</li><li>Disagree with arguments, not people.</li></ul></section>
        <section id="attendance"><h2>Attendance and punctuality</h2><p>Delegates are expected to attend every committee session and arrive on time.</p></section>
        <section id="integrity"><h2>Academic integrity</h2><p>Speeches, position papers and resolutions must be your own work.</p></section>
        <section id="concern"><h2>Raising a concern</h2><p>Speak to your chair or any member of the Secretariat, or email the Secretariat if something makes you uncomfortable or you see a breach of this code.</p></section>
      </article>
    </div>
  </section>
</Layout>
