import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/astro/PageHead.astro';
---

<Layout title="Position Paper Guide | RIT MUN">
  <PageHead title="Position Paper Guide" lede="What a position paper is, how to structure one and when it is due." crumbs={[{ label: 'Delegates', href: '/resources' }, { label: 'Position Paper Guide' }]} />
  <section class="guide-detail-section">
    <div class="guide-layout">
      <nav class="toc" aria-label="On this page"><h2>On this page</h2><ol><li><a href="#what">What it is</a></li><li><a href="#structure">Suggested structure</a></li><li><a href="#format">Format and submission</a></li><li><a href="#writing">Writing well</a></li></ol></nav>
      <article class="guide-prose">
        <p class="draft-note"><strong>Draft.</strong> This guide is based on standard Model UN practice. The Secretariat will publish the official version before the conference.</p>
        <aside class="confirmed"><h2>Confirmed</h2><ul><li>Due November 1, 2026.</li><li>Submission is required for award consideration.</li></ul></aside>
        <section id="what"><h2>What a position paper is</h2><p>A position paper sets out your assigned country’s view on a committee topic and what it wants the committee to do.</p></section>
        <section id="structure"><h2>Suggested structure</h2><ol class="steps"><li>Background: summarise the issue and why it matters.</li><li>Your country’s position: explain the effects and its past statements or action.</li><li>Past international action: note relevant treaties, resolutions and programmes.</li><li>Proposed solutions: set out specific measures for committee to adopt.</li></ol></section>
        <section id="format"><h2>Format and submission</h2><p>Length, formatting and submission instructions will be confirmed by the Secretariat. Write one paper per topic and cite sources.</p></section>
        <section id="writing"><h2>Writing well</h2><ul class="bullets"><li>Write as your country, not as yourself.</li><li>Use UN documents, government statements and reputable news first.</li><li>Be specific and cite evidence.</li><li>Plagiarised papers will not be considered.</li></ul></section>
      </article>
    </div>
  </section>
</Layout>
