---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/astro/PageHead.astro';
import { BookOpen, FileText, Link as LinkIcon } from 'lucide-react';
---

<Layout title="RIT MUN | Delegate Guides">
  <PageHead
    title="Delegate guides"
    lede="Everything you need to prepare for committee, whether this is your first conference or your tenth."
    crumbs={[{ label: 'Delegates' }]}
  />

  <section class="delegate-guides-section">
    <div class="delegate-guides-in">
      <p class="eyebrow">Prepare to participate</p>
      <h2 data-reveal>Guides</h2>
      <div class="guide-cards">
        <article class="guide-card" data-reveal>
          <BookOpen className="guide-icon" aria-hidden="true" />
          <h3><a href="/delegates/rules-of-procedure/">Rules of Procedure</a></h3>
          <p>How debate runs in committee: the flow of a session, points, motions and voting.</p>
          <a class="link-arrow" href="/delegates/rules-of-procedure/">Read the guide</a>
        </article>
        <article class="guide-card" data-reveal>
          <FileText className="guide-icon" aria-hidden="true" />
          <h3><a href="/delegates/position-papers/">Position Paper Guide</a></h3>
          <p>What a position paper is, how to structure one and when it is due.</p>
          <a class="link-arrow" href="/delegates/position-papers/">Read the guide</a>
        </article>
        <article class="guide-card" data-reveal>
          <FileText className="guide-icon" aria-hidden="true" />
          <h3><a href="/delegates/code-of-conduct/">Code of Conduct</a></h3>
          <p>The standards every delegate agrees to during the conference.</p>
          <a class="link-arrow" href="/delegates/code-of-conduct/">Read the guide</a>
        </article>
        <article class="guide-card" data-reveal>
          <BookOpen className="guide-icon" aria-hidden="true" />
          <h3>Delegate Handbook</h3>
          <p>Comprehensive conference guidance and reference material for delegates.</p>
          <a class="link-arrow" href="/documents/Final%20delegate%20handbook%20.docx" download>Download handbook</a>
        </article>
        <article class="guide-card guide-card-muted" data-reveal>
          <LinkIcon className="guide-icon" aria-hidden="true" />
          <h3>Research Links</h3>
          <p>Curated databases, UN records and reliable news sources for topic research.</p>
          <span class="soon-chip">Coming soon</span>
        </article>
      </div>
    </div>
  </section>
</Layout>
