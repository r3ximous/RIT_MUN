---
import Layout from '../layouts/Layout.astro';
import { BookOpen, Link as LinkIcon, FileText } from 'lucide-react';
import ResourceCard from '../components/astro/ResourceCard.astro';
---

<Layout title="RIT MUN | Resources">
  <div class="max-w-4xl mx-auto px-6 py-20 animate-in fade-in">
    <div class="mb-16">
      <h1 class="text-4xl md:text-5xl font-extrabold text-brand-dark mb-6">
        Delegate Resources
      </h1>
      <p class="text-xl text-gray-600 max-w-2xl">
        Essential documents, guides, and links to help you prepare for the
        conference and excel in committee sessions.
      </p>
    </div>

    <div class="space-y-8">
      <ResourceCard
        title="Delegate Handbook"
        description="Comprehensive conference guidance and reference material for delegates."
        href="/documents/Final%20delegate%20handbook%20.docx"
        download="Final delegate handbook .docx"
      >
        <BookOpen slot="icon" className="w-8 h-8" aria-hidden="true" />
      </ResourceCard>

      <ResourceCard
        title="Rules of Procedure"
        description="The official parliamentary rules used in all RIT MUN committees."
      >
        <BookOpen slot="icon" className="w-8 h-8" aria-hidden="true" />
      </ResourceCard>

      <ResourceCard
        title="Position Paper Guide"
        description="Guidelines, formatting requirements, and examples for writing an excellent position paper."
      >
        <FileText slot="icon" className="w-8 h-8" aria-hidden="true" />
      </ResourceCard>

      <ResourceCard
        title="Research Links"
        description="Curated databases, UN records, and reliable news sources for your topic research."
      >
        <LinkIcon slot="icon" className="w-8 h-8" aria-hidden="true" />
      </ResourceCard>
    </div>
  </div>
</Layout>
