---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/astro/PageHead.astro';

const allFaqs = await getCollection('faqs');
const sortedFaqs = allFaqs.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="RIT MUN | Frequently Asked Questions">
  <PageHead
    title="Frequently asked questions"
    lede="Answers to the questions delegates ask most often. If you need more help, contact the Secretariat."
    crumbs={[{ label: 'FAQ' }]}
  />
  <div class="faq-page-wrapper">
    <div class="faq-list">
      {
        sortedFaqs.map((faq) => (
          <details class="qa" data-reveal>
            <summary>
              <span>{faq.data.question}</span>
              <i class="qa-icon" aria-hidden="true"></i>
            </summary>
            <div class="qa-a"><p>{faq.data.answer}</p></div>
          </details>
        ))
      }
    </div>
  </div>
</Layout>
