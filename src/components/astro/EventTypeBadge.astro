---
interface Props {
  type: string;
}

const { type } = Astro.props;

const colorClasses: Record<string, string> = {
  Session: 'bg-blue-100 text-blue-800',
  Ceremony: 'bg-brand-orange text-white',
  Admin: 'bg-gray-200 text-gray-800',
};

const classes = colorClasses[type] ?? 'bg-purple-100 text-purple-800';
---

<span
  class={`px-3 py-1 rounded-full text-xs uppercase tracking-wider font-bold ${classes}`}
>
  {type}
</span>
