{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "day": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "order": {
      "default": 0,
      "type": "number"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "time": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "time",
          "title",
          "location",
          "type"
        ]
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "day",
    "date",
    "events"
  ]
}